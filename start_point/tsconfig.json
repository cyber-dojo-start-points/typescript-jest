{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    // Naming the target keeps the browser out of the type-check. Left unset,
    // tsc assumes es5, whose libraries declare every DOM global; jest runs
    // your tests under node, so code reaching for the DOM would type-check
    // here and then fail when it ran. Node's own globals, console and
    // setTimeout among them, come from @types/node and are unaffected.
    "target": "es2022",
    "lib": ["es2022"]
  }
}
